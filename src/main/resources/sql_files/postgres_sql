
CREATE TABLE db.users_type (
  user_type_id int NOT NULL GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 3),
  user_type_name varchar(255) DEFAULT NULL,
  PRIMARY KEY (user_type_id)
);

INSERT INTO db.users_type VALUES (1,'Recruiter'),(2,'Job Seeker');


CREATE TABLE db.users (
  user_id int NOT NULL GENERATED BY DEFAULT AS IDENTITY (START WITH 1 INCREMENT BY 1),
  email varchar(255) DEFAULT NULL,
  is_active bit(1) DEFAULT NULL,
  password varchar(255) DEFAULT NULL,
  registration_date TIMESTAMP DEFAULT NULL,
  user_type_id int DEFAULT NULL,
  PRIMARY KEY (user_id),
  UNIQUE (email),
  CONSTRAINT foreignKeyUserType FOREIGN KEY (user_type_id) REFERENCES db.users_type (user_type_id)
);


CREATE TABLE db.job_company (
  id int NOT NULL GENERATED BY DEFAULT AS IDENTITY(START WITH 1000) ,
  logo varchar(255) DEFAULT NULL,
  name varchar(255) DEFAULT NULL,
  PRIMARY KEY (id)
) ;


CREATE TABLE db.job_location (
  id int NOT NULL GENERATED BY DEFAULT AS IDENTITY(START WITH 2000),
  city varchar(255) DEFAULT NULL,
  country varchar(255) DEFAULT NULL,
  state varchar(255) DEFAULT NULL,
  PRIMARY KEY (id)
);


CREATE TABLE db.job_seeker_profile (
  user_account_id int NOT NULL,
  city varchar(255) DEFAULT NULL,
  country varchar(255) DEFAULT NULL,
  employment_type varchar(255) DEFAULT NULL,
  first_name varchar(255) DEFAULT NULL,
  last_name varchar(255) DEFAULT NULL,
  profile_photo varchar(255) DEFAULT NULL,
  resume varchar(255) DEFAULT NULL,
  state varchar(255) DEFAULT NULL,
  work_authorization varchar(255) DEFAULT NULL,
  PRIMARY KEY (user_account_id),
  CONSTRAINT user_fk FOREIGN KEY (user_account_id) REFERENCES db.users (user_id)
);


CREATE TABLE db.recruiter_profile (
  user_account_id int NOT NULL,
  city varchar(255) DEFAULT NULL,
  company varchar(255) DEFAULT NULL,
  country varchar(255) DEFAULT NULL,
  first_name varchar(255) DEFAULT NULL,
  last_name varchar(255) DEFAULT NULL,
  profile_photo varchar(64) DEFAULT NULL,
  state varchar(255) DEFAULT NULL,
  PRIMARY KEY (user_account_id),
  CONSTRAINT user_fk FOREIGN KEY (user_account_id) REFERENCES db.users (user_id)
);


CREATE TABLE db.job_post_activity (
  job_post_id int NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  description_of_job varchar(10000) DEFAULT NULL,
  job_title varchar(255) DEFAULT NULL,
  job_type varchar(255) DEFAULT NULL,
  posted_date TIMESTAMP DEFAULT NULL,
  remote varchar(255) DEFAULT NULL,
  salary varchar(255) DEFAULT NULL,
  job_company_id int DEFAULT NULL,
  job_location_id int DEFAULT NULL,
  posted_by_id int DEFAULT NULL,
  PRIMARY KEY (job_post_id),
  CONSTRAINT FK44003mnvj29aiijhsc6ftsgxe FOREIGN KEY (job_location_id) REFERENCES db.job_location (id),
  CONSTRAINT FK62yqqbypsq2ik34ngtlw4m9k3 FOREIGN KEY (posted_by_id) REFERENCES db.users (user_id),
  CONSTRAINT FKpjpv059hollr4tk92ms09s6is FOREIGN KEY (job_company_id) REFERENCES db.job_company (id)
);


CREATE TABLE db.job_seeker_save (
  id int NOT NULL generated by default as identity,
  job int DEFAULT NULL,
  user_id int DEFAULT NULL,
  PRIMARY KEY (id),
  CONSTRAINT user_job UNIQUE (user_id,job),
  CONSTRAINT FK96dyvgd8hmdohqsfdpvyl89mg FOREIGN KEY (user_id) REFERENCES DB.job_seeker_profile (user_account_id),
  CONSTRAINT FKpb44x040gkdltxqy9m7jmvvf3 FOREIGN KEY (job) REFERENCES db.job_post_activity (job_post_id)
) ;


CREATE TABLE db.job_seeker_apply (
  id int NOT NULL generated by default as identity,
  apply_date TIMESTAMP DEFAULT NULL,
  cover_letter varchar(255) DEFAULT NULL,
  job int DEFAULT NULL,
  user_id int DEFAULT NULL,
  PRIMARY KEY (id),
 CONSTRAINT user_job_apply UNIQUE  (user_id,job),
  CONSTRAINT fk1 FOREIGN KEY (job) REFERENCES db.job_post_activity (job_post_id),
  CONSTRAINT fk2 FOREIGN KEY (user_id) REFERENCES db.job_seeker_profile (user_account_id)
);


CREATE TABLE db.skills (
  id int NOT NULL generated by default as identity,
  experience_level varchar(255) DEFAULT NULL,
  name varchar(255) DEFAULT NULL,
  years_of_experience varchar(255) DEFAULT NULL,
  job_seeker_profile int DEFAULT NULL,
  PRIMARY KEY (id),
  CONSTRAINT FKsjdksau8sat30c00aqh5xf2wh FOREIGN KEY (job_seeker_profile) REFERENCES db.job_seeker_profile (user_account_id)
);